# EcoTrack — Environment Variables Configuration

# GEMINI_API_KEY: Injected by AI Studio at runtime from user secrets.
# Used for server-side AI grounded environmental synthesis fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# META_API_KEY: Optional. For direct Meta LLaMA 3.3 70B inference endpoint.
# Set when integrating official Meta API or Meta-hosted models.
META_API_KEY="your_meta_api_key_here"

# META_LLAMA_ENDPOINT: Optional endpoint URL for Meta AI model inference.
# Defaults to https://api.meta.ai/v1/chat/completions or custom provider gateway.
META_LLAMA_ENDPOINT="https://api.meta.ai/v1/chat/completions"

# OPENAQ_API_KEY: Optional. For authenticated OpenAQ API v3 higher-tier quotas.
# Open-Meteo Air Quality & Weather APIs run out-of-the-box with NO API key needed.
OPENAQ_API_KEY="your_openaq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000
