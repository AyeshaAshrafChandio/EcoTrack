# EcoTrack Environment Configuration
# ==============================================================================
# HACKATHON: Meta Global AI Developer Hackathon 2026 (Indie Developer Track)
# THEME: Build for Your World
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY AI INFERENCE PROVIDER: Cloudflare Workers AI (Free Plan)
# ------------------------------------------------------------------------------
# Primary Hackathon Meta Model: @cf/meta/llama-3.2-3b-instruct
# Free Quota: 10,000 Neurons/day free forever (No credit card or billing required).
# Obtain from: https://dash.cloudflare.com/ (Workers & Pages -> Overview / API Tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 2. SECONDARY AI INFERENCE PROVIDER: Groq Cloud (LPU Hardware)
# ------------------------------------------------------------------------------
# Models supported: llama-3.3-70b-versatile, llama-3.2-3b-preview
# Optional secondary provider. Adapter checks key and validates model access.
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. OFFLINE DEVELOPMENT / DEMO AI PROVIDER: Local Ollama
# ------------------------------------------------------------------------------
# Zero-API-key local inference running Meta Llama 3.2 3B locally.
# Default: http://localhost:11434 with model 'llama3.2:3b'
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. PHYSICAL GROUND-MONITOR SENSORS: OpenAQ v3 API
# ------------------------------------------------------------------------------
# Used for contributed reference ground-station observations.
# Obtain from: https://explore.openaq.org/register
OPENAQ_API_KEY=

# ------------------------------------------------------------------------------
# 5. USER AUTHENTICATION & ACCESS CONTROL: Firebase Authentication
# ------------------------------------------------------------------------------
# Firebase Spark Free Tier (No billing required).
# Server-side token verification:
FIREBASE_PROJECT_ID=

# Client-side web app credentials:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 6. ZERO-KEY PUBLIC SCIENTIFIC DATA PROVIDERS (Active Immediately)
# ------------------------------------------------------------------------------
# Open-Meteo Air Quality (Copernicus CAMS & ECMWF): 100% Free Public Open Data.
# Open-Meteo Physical Weather & Geocoding: 100% Free Public Open Data.
# CartoDB Dark Matter / OpenStreetMap tiles: Free CDN.